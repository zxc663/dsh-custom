{
  "feature": "dsh-custom-prompt-product-v2",
  "tier": 3,
  "initial": "targetUnselected",
  "states": {
    "targetUnselected": {"on": {"selectTarget": "targetLoading"}},
    "targetLoading": {"on": {"success": "effectiveLoading", "error": "targetError"}},
    "targetError": {"type": "error", "on": {"retry": "targetLoading", "chooseAnother": "targetUnselected"}},
    "effectiveLoading": {"on": {"success": "effectiveReady", "error": "effectiveError"}},
    "effectiveError": {"type": "error", "on": {"retry": "effectiveLoading", "chooseTarget": "targetUnselected"}},
    "effectiveReady": {"on": {"createDraft": "draftCreating", "openVersion": "versionViewing", "openHealth": "healthViewing", "changeTarget": "targetUnselected"}},
    "draftCreating": {"on": {"success": "draftEditing", "error": "draftError"}},
    "draftError": {"type": "error", "on": {"retry": "draftCreating", "back": "effectiveReady"}},
    "draftEditing": {"on": {"edit": "draftEditing", "saveDraft": "draftSaving", "runPreflight": "preflightRunning", "openDiff": "diffViewing", "discard": "effectiveReady", "publishReview": "publishReview"}},
    "draftSaving": {"on": {"success": "draftSaved", "error": "draftError", "cancel": "draftEditing"}},
    "draftSaved": {"on": {"edit": "draftEditing", "runPreflight": "preflightRunning", "openDiff": "diffViewing", "publishReview": "publishReview", "discard": "effectiveReady"}},
    "preflightRunning": {"on": {"pass": "preflightPassed", "warning": "preflightPassedWithWarnings", "fail": "preflightFailed", "cancel": "draftEditing"}},
    "preflightPassed": {"on": {"publishReview": "publishReview", "edit": "draftEditing", "openDiff": "diffViewing"}},
    "preflightPassedWithWarnings": {"on": {"publishReview": "publishReview", "edit": "draftEditing", "openHealth": "healthViewing"}},
    "preflightFailed": {"type": "error", "on": {"fix": "draftEditing", "retry": "preflightRunning", "discard": "effectiveReady"}},
    "diffViewing": {"on": {"back": "draftEditing", "publishReview": "publishReview"}},
    "publishReview": {"on": {"confirm": "publishing", "back": "draftEditing", "cancel": "draftEditing"}},
    "publishing": {"on": {"success": "publishedAwaitingRuntime", "error": "publishError", "cancel": "draftEditing"}},
    "publishError": {"type": "error", "on": {"retry": "publishing", "back": "publishReview", "restoreOld": "effectiveReady"}},
    "publishedAwaitingRuntime": {"on": {"runtimeEvidence": "effectiveVerified", "timeout": "evidencePending", "error": "evidenceError", "rollback": "rollbackReview"}},
    "evidencePending": {"on": {"retry": "publishedAwaitingRuntime", "openTarget": "effectiveLoading", "rollback": "rollbackReview"}},
    "evidenceError": {"type": "error", "on": {"retry": "publishedAwaitingRuntime", "keepOld": "effectiveReady", "rollback": "rollbackReview"}},
    "effectiveVerified": {"on": {"openVersion": "versionViewing", "rollback": "rollbackReview", "changeTarget": "targetUnselected"}},
    "versionViewing": {"on": {"back": "effectiveReady", "rollback": "rollbackReview", "createDraft": "draftCreating"}},
    "rollbackReview": {"on": {"confirm": "rollbackSnapshotting", "back": "versionViewing", "cancel": "effectiveReady"}},
    "rollbackSnapshotting": {"on": {"success": "rollbackRestoring", "error": "rollbackError"}},
    "rollbackRestoring": {"on": {"success": "publishedAwaitingRuntime", "error": "rollbackError"}},
    "rollbackError": {"type": "error", "on": {"retry": "rollbackSnapshotting", "back": "versionViewing", "keepCurrent": "effectiveReady"}},
    "healthViewing": {"on": {"fix": "draftCreating", "retry": "effectiveLoading", "back": "effectiveReady"}}
  },
  "recovery": [
    {"error": "targetError", "path": "retry or chooseAnother"},
    {"error": "effectiveError", "path": "retry or chooseTarget"},
    {"error": "draftError", "path": "retry or back"},
    {"error": "preflightFailed", "path": "fix or retry"},
    {"error": "publishError", "path": "retry, back, or restoreOld"},
    {"error": "evidenceError", "path": "retry, keepOld, or rollback"},
    {"error": "rollbackError", "path": "retry, back, or keepCurrent"}
  ]
}
